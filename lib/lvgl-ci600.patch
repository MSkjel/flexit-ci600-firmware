+/*Puts the object there now. What a change of LV_STYLE_X does besides: the parent's layout or content size may
+ *depend on it*/
+static void place(lv_obj_t * obj, lv_coord_t x, lv_coord_t y)
+{
+    obj->flags |= DIRECT_POS;
+    lv_obj_move_to(obj, x, y);
+    lv_obj_mark_layout_as_dirty(obj->parent);
