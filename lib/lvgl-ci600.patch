diff --git a/src/font/lv_font_fmt_txt.c b/src/font/lv_font_fmt_txt.c
index 78beaff..33ea77e 100644
--- a/src/font/lv_font_fmt_txt.c
+++ b/src/font/lv_font_fmt_txt.c
@@ -206,10 +206,34 @@ void _lv_font_clean_up_fmt_txt(void)
  *   STATIC FUNCTIONS
  **********************/
 
+/*CI600: the glyphs looked up last, for all fonts. Text is laid out again for every strip it's drawn in. letter in
+ *the low 21 bits, glyph id above*/
+#define GID_CACHE_BITS 5
+static struct {
+    const lv_font_fmt_txt_dsc_t * fdsc;
+    uint32_t letter_gid;
+} gid_cache[1 << GID_CACHE_BITS];
+
+static uint32_t get_glyph_dsc_id_uncached(const lv_font_t * font, uint32_t letter);
+
 static uint32_t get_glyph_dsc_id(const lv_font_t * font, uint32_t letter)
 {
     if(letter == '\0') return 0;
 
+    lv_font_fmt_txt_dsc_t * fdsc = (lv_font_fmt_txt_dsc_t *)font->dsc;
+    if(letter >= (1UL << 21)) return get_glyph_dsc_id_uncached(font, letter);
+    uint32_t h = ((letter ^ ((uint32_t)(lv_uintptr_t)fdsc >> 3)) * 2654435761UL) >> (32 - GID_CACHE_BITS);
+    if(gid_cache[h].fdsc == fdsc && (gid_cache[h].letter_gid & 0x1FFFFF) == letter) return gid_cache[h].letter_gid >> 21;
+    uint32_t gid = get_glyph_dsc_id_uncached(font, letter);
+    if(gid < (1UL << 11)) {
+        gid_cache[h].fdsc = fdsc;
+        gid_cache[h].letter_gid = letter | gid << 21;
+    }
+    return gid;
+}
+
+static uint32_t get_glyph_dsc_id_uncached(const lv_font_t * font, uint32_t letter)
+{
     lv_font_fmt_txt_dsc_t * fdsc = (lv_font_fmt_txt_dsc_t *)font->dsc;
 
     /*Check the cache first*/
