 {
     LV_ASSERT_OBJ(obj, MY_CLASS);
 
+    if(direct_pos(obj, x) && !LV_COORD_IS_SPEC(y)) {
+        place(obj, x, y);
+        return;
+    }
     lv_obj_set_x(obj, x);
     lv_obj_set_y(obj, y);
 }
