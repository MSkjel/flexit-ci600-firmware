diff --git a/src/core/lv_obj_style.c b/src/core/lv_obj_style.c
index ecffca9..1dbc36a 100644
--- a/src/core/lv_obj_style.c
+++ b/src/core/lv_obj_style.c
@@ -271,6 +271,10 @@ void lv_obj_set_local_style_prop(lv_obj_t * obj, lv_style_prop_t prop, lv_style_
                                  lv_style_selector_t selector)
 {
     lv_style_t * style = get_local_style(obj, selector);
+    /*CI600: setting the value it has already doesn't repaint the object. Compares the whole union:
+     *never "same" when it isn't, at worst "different" when it is (unused bytes of a colour)*/
+    lv_style_value_t old;
+    if(lv_style_get_prop(style, prop, &old) == LV_RES_OK && old.num == value.num && old.ptr == value.ptr) return;
     lv_style_set_prop(style, prop, value);
     lv_obj_refresh_style(obj, selector, prop);
 }
