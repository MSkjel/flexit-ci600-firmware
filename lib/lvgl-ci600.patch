+static bool set_size_core(lv_obj_t * obj, lv_obj_t * parent, lv_coord_t w, lv_coord_t h);
+
+/*Where the object is in its parent, the x and y lv_obj_move_to() placed it with*/
+static void kept_pos(const lv_obj_t * obj, lv_coord_t * x, lv_coord_t * y)
+{
+    const lv_obj_t * parent = obj->parent;
+    lv_coord_t px = 0, py = 0;
+    if(parent) {
+        lv_coord_t border = lv_obj_get_style_border_width(parent, LV_PART_MAIN);
+        px = parent->coords.x1 + lv_obj_get_style_pad_left(parent, LV_PART_MAIN) + border;
+        py = parent->coords.y1 + lv_obj_get_style_pad_top(parent, LV_PART_MAIN) + border;
+        if(!lv_obj_has_flag(obj, LV_OBJ_FLAG_FLOATING)) {
+            px -= lv_obj_get_scroll_x(parent);
+            py -= lv_obj_get_scroll_y(parent);
+        }
+    }
+    *x = obj->coords.x1 - px;
+    *y = obj->coords.y1 - py;
+}
+
+bool _lv_obj_pos_get(const lv_obj_t * obj, lv_style_prop_t prop, lv_style_value_t * v)
+{
+    if(prop == LV_STYLE_WIDTH && (obj->flags & DIRECT_W)) {
+        v->num = lv_area_get_width(&obj->coords);
+        return true;
+    }
+    if(prop == LV_STYLE_HEIGHT && (obj->flags & DIRECT_H)) {
+        v->num = lv_area_get_height(&obj->coords);
+        return true;
+    }
+    if((prop == LV_STYLE_X || prop == LV_STYLE_Y) && (obj->flags & DIRECT_POS)) {
+        lv_coord_t x, y;
+        kept_pos(obj, &x, &y);
+        v->num = prop == LV_STYLE_X ? x : y;
+        return true;
+    }
+    return false;
+}
+
+/*prop is about to be set on the object's local style and takes over from the coordinates*/
+void _lv_obj_pos_prop_set(lv_obj_t * obj, lv_style_prop_t prop)
+{
+    bool pos = prop == LV_STYLE_X || prop == LV_STYLE_Y || prop == LV_STYLE_ALIGN || prop == LV_STYLE_TRANSLATE_X ||
+               prop == LV_STYLE_TRANSLATE_Y;
+    if(pos && (obj->flags & DIRECT_POS)) {
+        lv_coord_t x, y;
+        kept_pos(obj, &x, &y);
+        obj->flags &= ~DIRECT_POS;
+        lv_obj_set_style_x(obj, x, 0);
+        lv_obj_set_style_y(obj, y, 0);
+    }
+    if(prop == LV_STYLE_WIDTH) obj->flags &= ~DIRECT_W;
+    if(prop == LV_STYLE_HEIGHT) obj->flags &= ~DIRECT_H;
+}
+
+/*A plain pixel value, and the object placed by nothing else: no alignment, translation or property of its own*/
+static bool direct_pos(lv_obj_t * obj, lv_coord_t v)
+{
+    lv_style_value_t p;
+    return !LV_COORD_IS_SPEC(v) && obj->parent &&
+           lv_obj_get_style_align(obj, LV_PART_MAIN) == LV_ALIGN_DEFAULT &&
+           lv_obj_get_style_translate_x(obj, LV_PART_MAIN) == 0 &&
+           lv_obj_get_style_translate_y(obj, LV_PART_MAIN) == 0 &&
+           lv_obj_get_local_style_prop(obj, LV_STYLE_X, &p, 0) == LV_STYLE_RES_NOT_FOUND &&
+           lv_obj_get_local_style_prop(obj, LV_STYLE_Y, &p, 0) == LV_STYLE_RES_NOT_FOUND;
+}
+
+/*Puts the object there now. What a change of LV_STYLE_X does besides: the parent's layout or content size may
+ *depend on it*/
+static void place(lv_obj_t * obj, lv_coord_t x, lv_coord_t y)
+{
+    obj->flags |= DIRECT_POS;
+    lv_obj_move_to(obj, x, y);
+    lv_obj_mark_layout_as_dirty(obj->parent);
+}
+
+/*The other coordinate of a direct placement: the one kept, else the style's, what lv_obj_refr_pos() would use*/
+static lv_coord_t other_pos(const lv_obj_t * obj, lv_style_prop_t prop)
+{
+    lv_style_value_t v;
+    if(_lv_obj_pos_get(obj, prop, &v)) return v.num;
+    return prop == LV_STYLE_X ? lv_obj_get_style_x(obj, LV_PART_MAIN) : lv_obj_get_style_y(obj, LV_PART_MAIN);
+}
+
+static bool direct_size(lv_obj_t * obj, lv_coord_t v, lv_style_prop_t prop, bool by_layout)
+{
+    lv_style_value_t p;
+    return !LV_COORD_IS_SPEC(v) && obj->parent && !by_layout &&
+           lv_obj_get_local_style_prop(obj, prop, &p, 0) == LV_STYLE_RES_NOT_FOUND;
+}
+
+/*Sizes the object now, as lv_obj_refr_size() would from these. Then what a change of LV_STYLE_WIDTH does besides:
+ *its own layout and the parent's follow*/
+static void resize(lv_obj_t * obj, lv_coord_t w, lv_coord_t h)
+{
+    lv_obj_t * parent = obj->parent;
+    w = lv_clamp_width(w, lv_obj_get_style_min_width(obj, LV_PART_MAIN), lv_obj_get_style_max_width(obj, LV_PART_MAIN),
+                       lv_obj_get_content_width(parent));
+    h = lv_clamp_height(h, lv_obj_get_style_min_height(obj, LV_PART_MAIN),
+                        lv_obj_get_style_max_height(obj, LV_PART_MAIN), lv_obj_get_content_height(parent));
+    set_size_core(obj, parent, w, h);
+    lv_obj_mark_layout_as_dirty(obj);
+    lv_obj_mark_layout_as_dirty(parent);
+}
