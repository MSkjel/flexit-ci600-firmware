+               prop == LV_STYLE_TRANSLATE_Y;
+    if(pos && (obj->flags & DIRECT_POS)) {
+        lv_coord_t x, y;
+        kept_pos(obj, &x, &y);
+        obj->flags &= ~DIRECT_POS;
+        lv_obj_set_style_x(obj, x, 0);
+        lv_obj_set_style_y(obj, y, 0);
+    }
+    if(prop == LV_STYLE_WIDTH) obj->flags &= ~DIRECT_W;
+    if(prop == LV_STYLE_HEIGHT) obj->flags &= ~DIRECT_H;
+}
+
+/*A plain pixel value, and the object placed by nothing else: no alignment, translation or property of its own*/
+static bool direct_pos(lv_obj_t * obj, lv_coord_t v)
+{
+    lv_style_value_t p;
+    return !LV_COORD_IS_SPEC(v) && obj->parent &&
+           lv_obj_get_style_align(obj, LV_PART_MAIN) == LV_ALIGN_DEFAULT &&
+           lv_obj_get_style_translate_x(obj, LV_PART_MAIN) == 0 &&
+           lv_obj_get_style_translate_y(obj, LV_PART_MAIN) == 0 &&
+           lv_obj_get_local_style_prop(obj, LV_STYLE_X, &p, 0) == LV_STYLE_RES_NOT_FOUND &&
+           lv_obj_get_local_style_prop(obj, LV_STYLE_Y, &p, 0) == LV_STYLE_RES_NOT_FOUND;
